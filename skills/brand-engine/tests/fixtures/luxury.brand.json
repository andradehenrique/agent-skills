    "emoji": "none"
  },
  "design": {
    "colors": {
      "canvas": {"name": "Noite", "hex": "#0B0A09"},
      "surface": {"name": "Fumê", "hex": "#16130F"},
      "ink": {"name": "Marfim", "hex": "#F2EBDD"},
      "primary": {"name": "Ouro Velho", "hex": "#C6A15B"},
      "accent": {"name": "Ameixa", "hex": "#6E3B52"},
      "support": [{"name": "Pedra", "hex": "#8C8577"}]
    },
    "feedback": {"warning": "#D9A441"},
