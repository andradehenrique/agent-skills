{
  "version": 2,
  "name": "Maison Verre",
  "purpose": "Compor perfumes de autor em pequenos lotes, para quem prefere memória a tendência.",
  "persona": "Colecionadores e quem procura presente de alto valor simbólico.",
  "territory": "silêncio, vidro e ouro velho",
  "archetype": "Amante",
  "attributes": ["sóbrio", "sensorial", "raro", "atemporal"],
  "voice": {
    "summary": "Descreve matéria e memória; nunca promete status.",
